<Project>

  <PropertyGroup>
    <!-- Kept in lockstep with Cargo.toml / package.json / pyproject.toml. -->
    <VersionPrefix>1.14.2</VersionPrefix>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <Authors>Firecrawl Team</Authors>
    <Company>Firecrawl</Company>
    <Product>pdf-inspector</Product>
    <Copyright>Copyright (c) Firecrawl</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/firecrawl/pdf-inspector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/firecrawl/pdf-inspector</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Native artifacts from a release build of dotnet/native are staged
         here by dotnet/build.sh (or build.ps1) before packing. -->
    <NativeAssetsDir>$(MSBuildThisFileDirectory)runtimes</NativeAssetsDir>
  </PropertyGroup>

</Project>
